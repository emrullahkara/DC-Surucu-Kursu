{
  "name": "dc-surucu-kursu",
  "version": "0.1.0",
  "private": true,
  "description": "Çok şubeli sürücü kursu takip uygulaması",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning server/index.mjs",
    "demo": "ENABLE_DEMO=1 VERI_DIZINI=veri-demo node --disable-warning=ExperimentalWarning server/index.mjs",
    "test": "node --disable-warning=ExperimentalWarning --test --test-concurrency=1 test/*.test.mjs",
    "build": "vite build --config istemci/vite.config.ts",
    "ekran": "vite --config istemci/vite.config.ts",
    "denetle": "tsc --noEmit -p ."
  },
  "dependencies": {
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.1"
  }
}
